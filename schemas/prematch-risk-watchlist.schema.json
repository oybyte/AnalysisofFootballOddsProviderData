{
  "$defs": {
    "EvaluatorType": {
      "enum": [
        "market_threshold",
        "market_and_trend",
        "structured_fact",
        "manual_only"
      ],
      "title": "EvaluatorType",
      "type": "string"
    },
    "MarketType": {
      "enum": [
        "asian_handicap",
        "european_odds",
        "kelly_index",
        "total_goals",
        "fixed_handicap_1x2"
      ],
      "title": "MarketType",
      "type": "string"
    },
    "RiskConditionV1": {
      "additionalProperties": false,
      "properties": {
        "condition_id": {
          "pattern": "^[a-z0-9][a-z0-9-]+$",
          "title": "Condition Id",
          "type": "string"
        },
        "consequence_text": {
          "minLength": 1,
          "title": "Consequence Text",
          "type": "string"
        },
        "evaluator_type": {
          "$ref": "#/$defs/EvaluatorType"
        },
        "field": {
          "anyOf": [
            {
              "enum": [
                "home_water",
                "away_water",
                "line",
                "home_win",
                "draw",
                "away_win",
                "over_water",
                "under_water"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "line_constraint": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Constraint"
        },
        "market": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarketType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "near_tolerance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Near Tolerance"
        },
        "operator": {
          "anyOf": [
            {
              "enum": [
                ">",
                ">=",
                "<",
                "<=",
                "=="
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator"
        },
        "original_risk_text": {
          "minLength": 1,
          "title": "Original Risk Text",
          "type": "string"
        },
        "phase": {
          "$ref": "#/$defs/SnapshotPhase",
          "default": "late"
        },
        "provider_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "required_data_types": {
          "items": {
            "type": "string"
          },
          "title": "Required Data Types",
          "type": "array"
        },
        "required_trend": {
          "anyOf": [
            {
              "enum": [
                "rising",
                "falling"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Required Trend"
        },
        "source_location": {
          "minLength": 1,
          "title": "Source Location",
          "type": "string"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "trigger_text": {
          "minLength": 1,
          "title": "Trigger Text",
          "type": "string"
        }
      },
      "required": [
        "condition_id",
        "original_risk_text",
        "trigger_text",
        "consequence_text",
        "evaluator_type",
        "source_location"
      ],
      "title": "RiskConditionV1",
      "type": "object"
    },
    "SnapshotPhase": {
      "enum": [
        "opening",
        "mid",
        "late",
        "live"
      ],
      "title": "SnapshotPhase",
      "type": "string"
    }
  },
  "$id": "https://odds-journal.local/schemas/prematch-risk-watchlist.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conditions": {
      "items": {
        "$ref": "#/$defs/RiskConditionV1"
      },
      "minItems": 1,
      "title": "Conditions",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_cutoff_at": {
      "format": "date-time",
      "title": "Data Cutoff At",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_analysis_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Analysis Receipt Sha256",
      "type": "string"
    },
    "source_section_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Section Sha256",
      "type": "string"
    },
    "source_text": {
      "minLength": 1,
      "title": "Source Text",
      "type": "string"
    },
    "supersedes_watchlist_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Watchlist Id"
    },
    "watchlist_id": {
      "pattern": "^watchlist-[a-z0-9-]+$",
      "title": "Watchlist Id",
      "type": "string"
    },
    "watchlist_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Watchlist Sha256",
      "type": "string"
    }
  },
  "required": [
    "watchlist_id",
    "match_id",
    "source_text",
    "conditions",
    "created_at",
    "data_cutoff_at",
    "source_analysis_receipt_sha256",
    "source_section_sha256",
    "watchlist_sha256"
  ],
  "title": "PrematchRiskWatchlistV1",
  "type": "object"
}
