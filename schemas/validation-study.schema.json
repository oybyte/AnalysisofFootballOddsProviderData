{
  "$defs": {
    "TimeWindow": {
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "$id": "https://odds-journal.local/schemas/validation-study.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allowed_case_types": {
      "items": {
        "enum": [
          "reviewed_match",
          "certified_legacy_case"
        ],
        "type": "string"
      },
      "title": "Allowed Case Types",
      "type": "array"
    },
    "ambiguous_definition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ambiguous Definition"
    },
    "approved_by": {
      "minLength": 1,
      "title": "Approved By",
      "type": "string"
    },
    "baseline_definition": {
      "minLength": 1,
      "title": "Baseline Definition",
      "type": "string"
    },
    "baseline_rate": {
      "maximum": 1,
      "minimum": 0,
      "title": "Baseline Rate",
      "type": "number"
    },
    "cluster_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cluster Key"
    },
    "cohort_case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Cohort Case Ids",
      "type": "array"
    },
    "counterexample_definition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Counterexample Definition"
    },
    "denominator_definition": {
      "minLength": 1,
      "title": "Denominator Definition",
      "type": "string"
    },
    "enrollment_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Enrollment Requirements",
      "type": "array"
    },
    "excluded_ai_fixture_fingerprints": {
      "items": {
        "type": "string"
      },
      "title": "Excluded Ai Fixture Fingerprints",
      "type": "array"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "leagues_or_seasons": {
      "items": {
        "type": "string"
      },
      "title": "Leagues Or Seasons",
      "type": "array"
    },
    "minimum_independent_cases": {
      "anyOf": [
        {
          "minimum": 30,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Independent Cases"
    },
    "not_applicable_definition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Not Applicable Definition"
    },
    "primary_market": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Primary Market"
    },
    "proposal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Sha256",
      "type": "string"
    },
    "rule_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "enum": [
        1,
        2,
        3
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "default": "frozen",
      "enum": [
        "frozen",
        "frozen_template"
      ],
      "title": "Status",
      "type": "string"
    },
    "study_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Study Id",
      "type": "string"
    },
    "support_definition": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Support Definition"
    },
    "target_definition": {
      "minLength": 1,
      "title": "Target Definition",
      "type": "string"
    },
    "time_windows": {
      "items": {
        "$ref": "#/$defs/TimeWindow"
      },
      "title": "Time Windows",
      "type": "array"
    }
  },
  "required": [
    "study_id",
    "rule_id",
    "proposal_sha256",
    "frozen_at",
    "target_definition",
    "denominator_definition",
    "baseline_definition",
    "baseline_rate",
    "approved_by"
  ],
  "title": "ValidationStudy",
  "type": "object"
}
