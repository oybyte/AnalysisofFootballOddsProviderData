{
  "$defs": {
    "TimeWindow": {
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "$id": "https://odds-journal.local/schemas/validation-study.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approved_by": {
      "minLength": 1,
      "title": "Approved By",
      "type": "string"
    },
    "baseline_definition": {
      "minLength": 1,
      "title": "Baseline Definition",
      "type": "string"
    },
    "baseline_rate": {
      "maximum": 1,
      "minimum": 0,
      "title": "Baseline Rate",
      "type": "number"
    },
    "cohort_case_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Cohort Case Ids",
      "type": "array"
    },
    "denominator_definition": {
      "minLength": 1,
      "title": "Denominator Definition",
      "type": "string"
    },
    "frozen_at": {
      "format": "date-time",
      "title": "Frozen At",
      "type": "string"
    },
    "leagues_or_seasons": {
      "items": {
        "type": "string"
      },
      "title": "Leagues Or Seasons",
      "type": "array"
    },
    "proposal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Sha256",
      "type": "string"
    },
    "rule_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Rule Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "const": "frozen",
      "default": "frozen",
      "title": "Status",
      "type": "string"
    },
    "study_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Study Id",
      "type": "string"
    },
    "target_definition": {
      "minLength": 1,
      "title": "Target Definition",
      "type": "string"
    },
    "time_windows": {
      "items": {
        "$ref": "#/$defs/TimeWindow"
      },
      "title": "Time Windows",
      "type": "array"
    }
  },
  "required": [
    "study_id",
    "rule_id",
    "proposal_sha256",
    "frozen_at",
    "target_definition",
    "denominator_definition",
    "baseline_definition",
    "baseline_rate",
    "cohort_case_ids",
    "approved_by"
  ],
  "title": "ValidationStudy",
  "type": "object"
}
