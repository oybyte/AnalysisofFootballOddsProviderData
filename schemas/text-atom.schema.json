{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/text-atom.schema.json",
  "title": "Source text atom",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "atom_id", "source_id", "source_path", "role", "atom_type", "byte_start", "byte_end", "line_start", "line_end", "heading_path", "content_sha256", "companion_atom_ids", "comparison_status"],
  "properties": {
    "schema_version": {"const": 1},
    "atom_id": {"type": "string"},
    "source_id": {"type": "string"},
    "source_path": {"type": "string"},
    "round_no": {"type": ["integer", "null"], "minimum": 1, "maximum": 207},
    "role": {"enum": ["user", "author", "preamble"]},
    "atom_type": {"enum": ["heading", "paragraph", "list", "table", "code", "image", "separator", "gap"]},
    "byte_start": {"type": "integer", "minimum": 0},
    "byte_end": {"type": "integer", "minimum": 1},
    "line_start": {"type": "integer", "minimum": 1},
    "line_end": {"type": "integer", "minimum": 1},
    "heading_path": {"type": "array", "items": {"type": "string"}},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "companion_atom_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "comparison_status": {"enum": ["identical", "media_only", "text_divergent", "unmatched"]}
  }
}
