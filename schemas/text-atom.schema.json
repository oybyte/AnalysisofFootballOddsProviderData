{
  "$id": "https://odds-journal.local/schemas/text-atom.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "atom_id": {
      "title": "Atom Id",
      "type": "string"
    },
    "atom_type": {
      "enum": [
        "heading",
        "paragraph",
        "list",
        "table",
        "code",
        "image",
        "separator",
        "gap"
      ],
      "title": "Atom Type",
      "type": "string"
    },
    "byte_end": {
      "exclusiveMinimum": 0,
      "title": "Byte End",
      "type": "integer"
    },
    "byte_start": {
      "minimum": 0,
      "title": "Byte Start",
      "type": "integer"
    },
    "companion_atom_ids": {
      "items": {
        "type": "string"
      },
      "title": "Companion Atom Ids",
      "type": "array"
    },
    "comparison_status": {
      "enum": [
        "identical",
        "media_only",
        "text_divergent",
        "unmatched"
      ],
      "title": "Comparison Status",
      "type": "string"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "heading_path": {
      "items": {
        "type": "string"
      },
      "title": "Heading Path",
      "type": "array"
    },
    "line_end": {
      "minimum": 1,
      "title": "Line End",
      "type": "integer"
    },
    "line_start": {
      "minimum": 1,
      "title": "Line Start",
      "type": "integer"
    },
    "role": {
      "enum": [
        "user",
        "author",
        "preamble"
      ],
      "title": "Role",
      "type": "string"
    },
    "round_no": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Round No"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_path": {
      "title": "Source Path",
      "type": "string"
    }
  },
  "required": [
    "atom_id",
    "source_id",
    "source_path",
    "role",
    "atom_type",
    "byte_start",
    "byte_end",
    "line_start",
    "line_end",
    "content_sha256",
    "comparison_status"
  ],
  "title": "TextAtom",
  "type": "object"
}
