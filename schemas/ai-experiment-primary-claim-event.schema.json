{
  "$id": "https://odds-journal.local/schemas/ai-experiment-primary-claim-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claimed_at": {
      "format": "date-time",
      "title": "Claimed At",
      "type": "string"
    },
    "config_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Snapshot Sha256",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "receipt_id": {
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "study_id": {
      "title": "Study Id",
      "type": "string"
    }
  },
  "required": [
    "match_id",
    "receipt_id",
    "study_id",
    "config_snapshot_sha256",
    "claimed_at"
  ],
  "title": "AIExperimentPrimaryClaimEventV1",
  "type": "object"
}
