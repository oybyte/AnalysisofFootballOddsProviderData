{
  "$defs": {
    "Evaluation": {
      "properties": {
        "confidence_calibration": {
          "$ref": "#/$defs/EvaluationValue",
          "default": "pending"
        },
        "handicap": {
          "$ref": "#/$defs/EvaluationValue",
          "default": "pending"
        },
        "primary": {
          "$ref": "#/$defs/EvaluationValue",
          "default": "pending"
        },
        "score_range": {
          "$ref": "#/$defs/EvaluationValue",
          "default": "pending"
        },
        "total_goals_range": {
          "$ref": "#/$defs/EvaluationValue",
          "default": "pending"
        }
      },
      "title": "Evaluation",
      "type": "object"
    },
    "EvaluationValue": {
      "enum": [
        "pending",
        "correct",
        "wrong",
        "partial",
        "not_applicable"
      ],
      "title": "EvaluationValue",
      "type": "string"
    },
    "HandicapResult": {
      "enum": [
        "home_handicap",
        "away_handicap",
        "push"
      ],
      "title": "HandicapResult",
      "type": "string"
    },
    "MatchStatus": {
      "enum": [
        "draft",
        "tracking",
        "locked",
        "finished",
        "reviewed",
        "void"
      ],
      "title": "MatchStatus",
      "type": "string"
    },
    "PrimaryMarket": {
      "enum": [
        "one_x_two",
        "handicap",
        "total_goals",
        "pass"
      ],
      "title": "PrimaryMarket",
      "type": "string"
    },
    "RecordIntegrity": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "RecordIntegrity",
      "type": "string"
    },
    "Result1X2": {
      "enum": [
        "home",
        "draw",
        "away"
      ],
      "title": "Result1X2",
      "type": "string"
    },
    "Selection": {
      "enum": [
        "home",
        "draw",
        "away",
        "home_handicap",
        "away_handicap",
        "over",
        "under",
        "pass"
      ],
      "title": "Selection",
      "type": "string"
    }
  },
  "$id": "https://odds-journal.local/schemas/match.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "analysis_started_at": {
      "format": "date-time",
      "title": "Analysis Started At",
      "type": "string"
    },
    "away_team": {
      "minLength": 1,
      "title": "Away Team",
      "type": "string"
    },
    "away_team_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Away Team Id",
      "type": "string"
    },
    "competition": {
      "minLength": 1,
      "title": "Competition",
      "type": "string"
    },
    "competition_code": {
      "minLength": 1,
      "title": "Competition Code",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "data_cutoff_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Cutoff At"
    },
    "data_sources": {
      "items": {
        "type": "string"
      },
      "title": "Data Sources",
      "type": "array"
    },
    "evaluation": {
      "$ref": "#/$defs/Evaluation"
    },
    "handicap_result": {
      "anyOf": [
        {
          "$ref": "#/$defs/HandicapResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "home_team": {
      "minLength": 1,
      "title": "Home Team",
      "type": "string"
    },
    "home_team_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Home Team Id",
      "type": "string"
    },
    "key_events": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Key Events"
    },
    "kickoff_at": {
      "format": "date-time",
      "title": "Kickoff At",
      "type": "string"
    },
    "live_update_changed_main": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Live Update Changed Main"
    },
    "locked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locked At"
    },
    "match_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Match Id",
      "type": "string"
    },
    "prematch_lock_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Prematch Lock Sha256"
    },
    "primary_market": {
      "anyOf": [
        {
          "$ref": "#/$defs/PrimaryMarket"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "primary_selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/Selection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "record_integrity": {
      "$ref": "#/$defs/RecordIntegrity",
      "default": "complete"
    },
    "result_1x2": {
      "anyOf": [
        {
          "$ref": "#/$defs/Result1X2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "result_recorded_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Recorded At"
    },
    "reviewed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed At"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "score": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Score"
    },
    "season": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Season"
    },
    "secondary_selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/Selection"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/MatchStatus",
      "default": "draft"
    },
    "supersedes_match_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Match Id"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "timezone": {
      "default": "Asia/Shanghai",
      "title": "Timezone",
      "type": "string"
    },
    "total_goals": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Goals"
    },
    "void_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Void Reason"
    }
  },
  "required": [
    "match_id",
    "kickoff_at",
    "competition_code",
    "competition",
    "home_team_id",
    "home_team",
    "away_team_id",
    "away_team",
    "analysis_started_at"
  ],
  "title": "MatchMetadata",
  "type": "object"
}
