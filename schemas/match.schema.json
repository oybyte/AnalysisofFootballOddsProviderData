{
  "$defs": {
    "AnalysisDataMode": {
      "enum": [
        "complete",
        "degraded",
        "pass"
      ],
      "title": "AnalysisDataMode",
      "type": "string"
    },
    "AnalysisDimension": {
      "enum": [
        "asian_handicap_market",
        "european_odds",
        "kelly_index",
        "total_goals_market"
      ],
      "title": "AnalysisDimension",
      "type": "string"
    },
    "AnalysisOutlook": {
      "properties": {
        "anchor_change_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Change Reason"
        },
        "asian_handicap": {
          "anyOf": [
            {
              "$ref": "#/$defs/AsianHandicapOutlook"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "baseline_gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineGate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "baseline_summary_v3": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineSummaryV3"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "calibration_contract_version": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Contract Version"
        },
        "calibration_events": {
          "items": {
            "$ref": "#/$defs/CalibrationEvent"
          },
          "title": "Calibration Events",
          "type": "array"
        },
        "calibration_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibrationSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "competition_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Competition Profile"
        },
        "correlated_dimensions": {
          "items": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Correlated Dimensions",
          "type": "array"
        },
        "data_mode": {
          "$ref": "#/$defs/AnalysisDataMode"
        },
        "decision_actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Actor"
        },
        "dimension_assessments": {
          "items": {
            "$ref": "#/$defs/DimensionAssessment"
          },
          "title": "Dimension Assessments",
          "type": "array"
        },
        "experimental_rankings": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Experimental Rankings",
          "type": "object"
        },
        "final_rankings": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Final Rankings",
          "type": "object"
        },
        "fixed_handicap_1x2": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixedHandicapOutlook"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "independent_dimensions": {
          "items": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Independent Dimensions",
          "type": "array"
        },
        "missing_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Missing Reasons",
          "type": "array"
        },
        "one_x_two": {
          "anyOf": [
            {
              "$ref": "#/$defs/RankedOutcomes"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome_risk_pool": {
          "items": {
            "$ref": "#/$defs/OutcomeRiskCandidate"
          },
          "title": "Outcome Risk Pool",
          "type": "array"
        },
        "pass_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Pass Reasons",
          "type": "array"
        },
        "resonance_status": {
          "$ref": "#/$defs/ResonanceStatus",
          "default": "insufficient"
        },
        "schema_version": {
          "default": 1,
          "enum": [
            1,
            2,
            3
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "score_candidate_pool": {
          "items": {
            "$ref": "#/$defs/ScoreCandidate"
          },
          "title": "Score Candidate Pool",
          "type": "array"
        },
        "score_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Score Candidates",
          "type": "array"
        },
        "score_matrix": {
          "anyOf": [
            {
              "$ref": "#/$defs/MultiMarketScoreMatrix"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "total_goals": {
          "anyOf": [
            {
              "$ref": "#/$defs/TotalGoalsOutlook"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "total_goals_candidate_pool": {
          "items": {
            "$ref": "#/$defs/TotalGoalsCandidate"
          },
          "title": "Total Goals Candidate Pool",
          "type": "array"
        },
        "weight_model": {
          "$ref": "#/$defs/WeightModel"
        }
      },
      "required": [
        "data_mode"
      ],
      "title": "AnalysisOutlook",
      "type": "object"
    },
    "AsianCalibrationSummary": {
      "additionalProperties": false,
      "properties": {
        "cover_signal": {
          "default": "neutral",
          "enum": [
            "support",
            "risk",
            "neutral"
          ],
          "title": "Cover Signal",
          "type": "string"
        },
        "cover_signal_rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cover Signal Rule Ids",
          "type": "array"
        }
      },
      "title": "AsianCalibrationSummary",
      "type": "object"
    },
    "AsianHandicapOutlook": {
      "properties": {
        "home_line": {
          "title": "Home Line",
          "type": "number"
        },
        "line_display": {
          "minLength": 1,
          "title": "Line Display",
          "type": "string"
        },
        "ranking": {
          "$ref": "#/$defs/RankedOutcomes"
        }
      },
      "required": [
        "line_display",
        "home_line",
        "ranking"
      ],
      "title": "AsianHandicapOutlook",
      "type": "object"
    },
    "AsianSettlement": {
      "enum": [
        "full_win",
        "half_win",
        "push",
        "half_loss",
        "full_loss"
      ],
      "title": "AsianSettlement",
      "type": "string"
    },
    "BaselineGate": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "ready",
            "degraded",
            "pass"
          ],
          "title": "Decision",
          "type": "string"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Fact Refs",
          "type": "array"
        },
        "facts_status": {
          "enum": [
            "complete",
            "incomplete",
            "conflicted"
          ],
          "title": "Facts Status",
          "type": "string"
        },
        "market_relation": {
          "enum": [
            "aligned",
            "explained_divergence",
            "unexplained_divergence"
          ],
          "title": "Market Relation",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "theoretical_positioning": {
          "enum": [
            "established",
            "unavailable"
          ],
          "title": "Theoretical Positioning",
          "type": "string"
        }
      },
      "required": [
        "facts_status",
        "theoretical_positioning",
        "market_relation",
        "decision"
      ],
      "title": "BaselineGate",
      "type": "object"
    },
    "BaselineSummaryV3": {
      "additionalProperties": false,
      "properties": {
        "markets": {
          "additionalProperties": {
            "$ref": "#/$defs/MarketScoreSummary"
          },
          "title": "Markets",
          "type": "object"
        },
        "pass_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Pass Reasons",
          "type": "array"
        },
        "primary_market": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrimaryMarket"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "primary_selection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Selection"
        }
      },
      "required": [
        "markets"
      ],
      "title": "BaselineSummaryV3",
      "type": "object"
    },
    "CalibrationEvent": {
      "additionalProperties": false,
      "properties": {
        "adjustment_level": {
          "maximum": 1,
          "minimum": -1,
          "title": "Adjustment Level",
          "type": "integer"
        },
        "applicability": {
          "default": "applicable",
          "enum": [
            "applicable",
            "not_applicable"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "before_ranking": {
          "items": {
            "type": "string"
          },
          "title": "Before Ranking",
          "type": "array"
        },
        "contract_version": {
          "default": 2,
          "enum": [
            1,
            2,
            3
          ],
          "title": "Contract Version",
          "type": "integer"
        },
        "correlation_keys": {
          "items": {
            "type": "string"
          },
          "title": "Correlation Keys",
          "type": "array"
        },
        "counter_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence",
          "type": "array"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateDisposition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effect": {
          "default": "ranking",
          "enum": [
            "ranking",
            "handicap_signal",
            "total_goals_pool",
            "score_pool",
            "outcome_risk_pool"
          ],
          "title": "Effect",
          "type": "string"
        },
        "final_ranking": {
          "items": {
            "type": "string"
          },
          "title": "Final Ranking",
          "type": "array"
        },
        "not_triggered_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Triggered Reason"
        },
        "primary_changed": {
          "default": false,
          "title": "Primary Changed",
          "type": "boolean"
        },
        "proposed_ranking": {
          "items": {
            "type": "string"
          },
          "title": "Proposed Ranking",
          "type": "array"
        },
        "reliability": {
          "const": "experimental",
          "default": "experimental",
          "title": "Reliability",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "source_dimensions": {
          "items": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Source Dimensions",
          "type": "array"
        },
        "source_provider_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Provider Ids",
          "type": "array"
        },
        "source_snapshot_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        },
        "target_market": {
          "anyOf": [
            {
              "enum": [
                "one_x_two",
                "asian_handicap",
                "fixed_handicap_1x2",
                "total_goals",
                "handicap"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Market"
        },
        "target_selection": {
          "title": "Target Selection",
          "type": "string"
        },
        "threshold_observations": {
          "additionalProperties": true,
          "title": "Threshold Observations",
          "type": "object"
        },
        "triggered": {
          "title": "Triggered",
          "type": "boolean"
        }
      },
      "required": [
        "rule_id",
        "triggered",
        "target_selection",
        "adjustment_level"
      ],
      "title": "CalibrationEvent",
      "type": "object"
    },
    "CalibrationMarketSummary": {
      "additionalProperties": false,
      "properties": {
        "anchor_change_eligible": {
          "default": false,
          "title": "Anchor Change Eligible",
          "type": "boolean"
        },
        "anchor_change_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Change Reason"
        },
        "anchor_changed": {
          "default": false,
          "title": "Anchor Changed",
          "type": "boolean"
        },
        "baseline_ranking": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Baseline Ranking",
          "type": "array"
        },
        "final_ranking": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Final Ranking",
          "type": "array"
        }
      },
      "required": [
        "baseline_ranking",
        "final_ranking"
      ],
      "title": "CalibrationMarketSummary",
      "type": "object"
    },
    "CalibrationSummary": {
      "additionalProperties": false,
      "properties": {
        "asian_handicap": {
          "$ref": "#/$defs/AsianCalibrationSummary"
        },
        "fixed_handicap_1x2": {
          "$ref": "#/$defs/CalibrationMarketSummary"
        },
        "one_x_two": {
          "$ref": "#/$defs/CalibrationMarketSummary"
        }
      },
      "required": [
        "one_x_two",
        "fixed_handicap_1x2"
      ],
      "title": "CalibrationSummary",
      "type": "object"
    },
    "CandidateDisposition": {
      "additionalProperties": false,
      "properties": {
        "counter_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence Refs",
          "type": "array"
        },
        "disposition": {
          "enum": [
            "adopted",
            "excluded"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Reason"
        }
      },
      "required": [
        "disposition"
      ],
      "title": "CandidateDisposition",
      "type": "object"
    },
    "DimensionAssessment": {
      "properties": {
        "candidate_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Candidate Scores",
          "type": "object"
        },
        "configured_weight": {
          "maximum": 100,
          "minimum": 0,
          "title": "Configured Weight",
          "type": "integer"
        },
        "correlated_with": {
          "items": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Correlated With",
          "type": "array"
        },
        "counter_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence",
          "type": "array"
        },
        "dimension": {
          "$ref": "#/$defs/AnalysisDimension"
        },
        "effective_weight": {
          "maximum": 100,
          "minimum": 0,
          "title": "Effective Weight",
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Fact Refs",
          "type": "array"
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "configured_weight",
        "effective_weight"
      ],
      "title": "DimensionAssessment",
      "type": "object"
    },
    "Evaluation": {
      "properties": {
        "confidence_calibration": {
          "$ref": "#/$defs/EvaluationValue",
          "default": "pending"
        },
        "handicap": {
          "$ref": "#/$defs/EvaluationValue",
          "default": "pending"
        },
        "primary": {
          "$ref": "#/$defs/EvaluationValue",
          "default": "pending"
        },
        "score_range": {
          "$ref": "#/$defs/EvaluationValue",
          "default": "pending"
        },
        "total_goals_range": {
          "$ref": "#/$defs/EvaluationValue",
          "default": "pending"
        }
      },
      "title": "Evaluation",
      "type": "object"
    },
    "EvaluationValue": {
      "enum": [
        "pending",
        "correct",
        "wrong",
        "partial",
        "not_applicable"
      ],
      "title": "EvaluationValue",
      "type": "string"
    },
    "FixedHandicapOutlook": {
      "properties": {
        "home_line": {
          "title": "Home Line",
          "type": "integer"
        },
        "ranking": {
          "$ref": "#/$defs/RankedOutcomes"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "home_line",
        "source_type",
        "ranking"
      ],
      "title": "FixedHandicapOutlook",
      "type": "object"
    },
    "FixedHandicapResult": {
      "enum": [
        "handicap_home",
        "handicap_draw",
        "handicap_away"
      ],
      "title": "FixedHandicapResult",
      "type": "string"
    },
    "HandicapResult": {
      "enum": [
        "home_handicap",
        "away_handicap",
        "push"
      ],
      "title": "HandicapResult",
      "type": "string"
    },
    "MarketScoreCell": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Scores",
          "type": "object"
        },
        "status": {
          "enum": [
            "assessed",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "MarketScoreCell",
      "type": "object"
    },
    "MarketScoreSummary": {
      "additionalProperties": false,
      "properties": {
        "candidate_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Candidate Scores",
          "type": "object"
        },
        "effective_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Effective Weights",
          "type": "object"
        },
        "ranking": {
          "items": {
            "type": "string"
          },
          "title": "Ranking",
          "type": "array"
        },
        "tie_groups": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Tie Groups",
          "type": "array"
        },
        "top_margin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Top Margin"
        },
        "top_tied": {
          "title": "Top Tied",
          "type": "boolean"
        }
      },
      "required": [
        "candidate_scores",
        "effective_weights",
        "ranking",
        "tie_groups",
        "top_tied",
        "top_margin"
      ],
      "title": "MarketScoreSummary",
      "type": "object"
    },
    "MarketSnapshot": {
      "properties": {
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "market": {
          "$ref": "#/$defs/MarketType"
        },
        "normalized_values": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Normalized Values",
          "type": "object"
        },
        "odds_format": {
          "$ref": "#/$defs/OddsFormat"
        },
        "phase": {
          "$ref": "#/$defs/SnapshotPhase"
        },
        "provider_id": {
          "pattern": "^[a-z0-9][a-z0-9-]+$",
          "title": "Provider Id",
          "type": "string"
        },
        "raw_values": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Raw Values",
          "type": "object"
        },
        "snapshot_id": {
          "pattern": "^[a-z0-9][a-z0-9-]+$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "market",
        "phase",
        "captured_at",
        "provider_id",
        "source_ref",
        "odds_format",
        "raw_values"
      ],
      "title": "MarketSnapshot",
      "type": "object"
    },
    "MarketType": {
      "enum": [
        "asian_handicap",
        "european_odds",
        "kelly_index",
