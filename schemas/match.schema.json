{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/match.schema.json",
  "title": "Odds Journal Match Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "match_id",
    "kickoff_at",
    "timezone",
    "competition_code",
    "competition",
    "home_team_id",
    "home_team",
    "away_team_id",
    "away_team",
    "status",
    "analysis_started_at",
    "evaluation"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "match_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "supersedes_match_id": {"type": ["string", "null"]},
    "kickoff_at": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string"},
    "competition_code": {"type": "string", "minLength": 1},
    "competition": {"type": "string", "minLength": 1},
    "season": {"type": ["integer", "null"]},
    "home_team_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "home_team": {"type": "string", "minLength": 1},
    "away_team_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "away_team": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "tracking", "locked", "finished", "reviewed", "void"]},
    "record_integrity": {"enum": ["complete", "incomplete"]},
    "analysis_started_at": {"type": "string", "format": "date-time"},
    "data_cutoff_at": {"type": ["string", "null"], "format": "date-time"},
    "locked_at": {"type": ["string", "null"], "format": "date-time"},
    "prematch_lock_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "primary_market": {"enum": ["one_x_two", "handicap", "total_goals", "pass", null]},
    "primary_selection": {"enum": ["home", "draw", "away", "home_handicap", "away_handicap", "over", "under", "pass", null]},
    "secondary_selection": {"enum": ["home", "draw", "away", "home_handicap", "away_handicap", "over", "under", "pass", null]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "result_recorded_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "void_reason": {"type": ["string", "null"]},
    "score": {"type": ["string", "null"], "pattern": "^\\d+-\\d+$"},
    "result_1x2": {"enum": ["home", "draw", "away", null]},
    "handicap_result": {"enum": ["home_handicap", "away_handicap", "push", null]},
    "total_goals": {"type": ["integer", "null"], "minimum": 0},
    "key_events": {"type": ["string", "null"]},
    "live_update_changed_main": {"type": ["boolean", "null"]},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "data_sources": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evaluation": {
      "type": "object",
      "required": ["primary", "handicap", "total_goals_range", "score_range", "confidence_calibration"],
      "properties": {
        "primary": {"$ref": "#/$defs/evaluation"},
        "handicap": {"$ref": "#/$defs/evaluation"},
        "total_goals_range": {"$ref": "#/$defs/evaluation"},
        "score_range": {"$ref": "#/$defs/evaluation"},
        "confidence_calibration": {"$ref": "#/$defs/evaluation"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "evaluation": {
      "enum": ["pending", "correct", "wrong", "partial", "not_applicable"]
    }
  }
}

