{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/ledger-event.schema.json",
  "title": "Append-only ledger event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "recorded_at", "actor", "previous_event_sha256", "payload", "event_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]+$"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "previous_event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "supersedes_event_id": {"type": ["string", "null"]},
    "payload": {"type": "object"},
    "event_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
