{
  "$defs": {
    "SegmentType": {
      "enum": [
        "prematch_facts",
        "market_data",
        "prematch_analysis",
        "prematch_conclusion",
        "live_update",
        "result",
        "postmatch_review",
        "correction",
        "unclassified"
      ],
      "title": "SegmentType",
      "type": "string"
    }
  },
  "$id": "https://odds-journal.local/schemas/journal-segment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ambiguity_flags": {
      "items": {
        "type": "string"
      },
      "title": "Ambiguity Flags",
      "type": "array"
    },
    "classification_confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Classification Confidence",
      "type": "number"
    },
    "data_cutoff_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Data Cutoff At"
    },
    "normalized_markdown": {
      "default": "",
      "title": "Normalized Markdown",
      "type": "string"
    },
    "observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed At"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "segment_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Segment Id",
      "type": "string"
    },
    "segment_type": {
      "$ref": "#/$defs/SegmentType"
    },
    "source_line_end": {
      "minimum": 1,
      "title": "Source Line End",
      "type": "integer"
    },
    "source_line_start": {
      "minimum": 1,
      "title": "Source Line Start",
      "type": "integer"
    }
  },
  "required": [
    "segment_id",
    "segment_type",
    "source_line_start",
    "source_line_end",
    "classification_confidence"
  ],
  "title": "JournalSegmentV1",
  "type": "object"
}
