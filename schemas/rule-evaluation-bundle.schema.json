{
  "$defs": {
    "EvaluationBundle": {
      "additionalProperties": false,
      "properties": {
        "baseline_summary": {
          "additionalProperties": true,
          "title": "Baseline Summary",
          "type": "object"
        },
        "bundle_sha256": {
          "title": "Bundle Sha256",
          "type": "string"
        },
        "calibration_config_sha256": {
          "title": "Calibration Config Sha256",
          "type": "string"
        },
        "competition_profile": {
          "title": "Competition Profile",
          "type": "string"
        },
        "cutoff_at": {
          "format": "date-time",
          "title": "Cutoff At",
          "type": "string"
        },
        "draft_input_sha256": {
          "title": "Draft Input Sha256",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/MachineRuleEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "feature_snapshot_sha256": {
          "title": "Feature Snapshot Sha256",
          "type": "string"
        },
        "features": {
          "additionalProperties": true,
          "title": "Features",
          "type": "object"
        },
        "market_snapshot_sha256": {
          "title": "Market Snapshot Sha256",
          "type": "string"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "profile_chain": {
          "items": {
            "type": "string"
          },
          "title": "Profile Chain",
          "type": "array"
        },
        "ruleset_version": {
          "title": "Ruleset Version",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "match_id",
        "cutoff_at",
        "ruleset_version",
        "calibration_config_sha256",
        "draft_input_sha256",
        "market_snapshot_sha256",
        "feature_snapshot_sha256",
        "profile_chain",
        "competition_profile",
        "baseline_summary",
        "features",
        "events",
        "bundle_sha256"
      ],
      "title": "EvaluationBundle",
      "type": "object"
    },
    "EvaluationBundleV2": {
      "additionalProperties": false,
      "properties": {
        "baseline_summary": {
          "additionalProperties": true,
          "title": "Baseline Summary",
          "type": "object"
        },
        "bundle_sha256": {
          "title": "Bundle Sha256",
          "type": "string"
        },
        "calibration_config_sha256": {
          "title": "Calibration Config Sha256",
          "type": "string"
        },
        "competition_profile": {
          "title": "Competition Profile",
          "type": "string"
        },
        "cutoff_at": {
          "format": "date-time",
          "title": "Cutoff At",
          "type": "string"
        },
        "draft_input_sha256": {
          "title": "Draft Input Sha256",
          "type": "string"
        },
        "events": {
          "items": {},
          "title": "Events",
          "type": "array"
        },
        "feature_snapshot_sha256": {
          "title": "Feature Snapshot Sha256",
          "type": "string"
        },
        "features": {
          "additionalProperties": true,
          "title": "Features",
          "type": "object"
        },
        "market_snapshot_sha256": {
          "title": "Market Snapshot Sha256",
          "type": "string"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "profile_chain": {
          "items": {
            "type": "string"
          },
          "title": "Profile Chain",
          "type": "array"
        },
        "ruleset_version": {
          "title": "Ruleset Version",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "total_goals_pass_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Total Goals Pass Reasons",
          "type": "array"
        },
        "total_goals_series": {
          "items": {
            "$ref": "#/$defs/TotalGoalsSeriesV2"
          },
          "title": "Total Goals Series",
          "type": "array"
        },
        "total_goals_signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TotalGoalsSignalV5"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_goals_status": {
          "enum": [
            "assessed",
            "pass"
          ],
          "title": "Total Goals Status",
          "type": "string"
        }
      },
      "required": [
        "match_id",
        "cutoff_at",
        "ruleset_version",
        "calibration_config_sha256",
        "draft_input_sha256",
        "market_snapshot_sha256",
        "feature_snapshot_sha256",
        "profile_chain",
        "competition_profile",
        "baseline_summary",
        "features",
        "events",
        "total_goals_series",
        "total_goals_status",
        "total_goals_pass_reasons",
        "total_goals_signal",
        "bundle_sha256"
      ],
      "title": "EvaluationBundleV2",
      "type": "object"
    },
    "EvaluationBundleV3": {
      "additionalProperties": false,
      "properties": {
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "calibration_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Calibration Config Sha256",
          "type": "string"
        },
        "competition_profile": {
          "title": "Competition Profile",
          "type": "string"
        },
        "cutoff_at": {
          "format": "date-time",
          "title": "Cutoff At",
          "type": "string"
        },
        "draft_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Draft Input Sha256",
          "type": "string"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/MachineRuleEvent"
          },
          "title": "Events",
          "type": "array"
        },
        "feature_snapshot_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Snapshot Sha256",
          "type": "string"
        },
        "features": {
          "additionalProperties": true,
          "title": "Features",
          "type": "object"
        },
        "formal_gate": {
          "$ref": "#/$defs/FormalAnalysisGateV2"
        },
        "market_assessments": {
          "additionalProperties": {
            "$ref": "#/$defs/MarketAssessmentV1"
          },
          "title": "Market Assessments",
          "type": "object"
        },
        "market_observations_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Market Observations Sha256",
          "type": "string"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "profile_chain": {
          "items": {
            "type": "string"
          },
          "title": "Profile Chain",
          "type": "array"
        },
        "ruleset_version": {
          "title": "Ruleset Version",
          "type": "string"
        },
        "schema_version": {
          "const": 3,
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "match_id",
        "cutoff_at",
        "ruleset_version",
        "calibration_config_sha256",
        "draft_input_sha256",
        "market_observations_sha256",
        "feature_snapshot_sha256",
        "profile_chain",
        "competition_profile",
        "formal_gate",
        "market_assessments",
        "features",
        "events",
        "bundle_sha256"
      ],
      "title": "EvaluationBundleV3",
      "type": "object"
    },
    "EvaluationBundleV4": {
      "additionalProperties": false,
      "description": "Contract 9 评估包 V4。\n\n由可追溯草稿输入生成，包含 V7 市场语义。",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "baseline_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Baseline Sha256",
          "type": "string"
        },
        "bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Sha256",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "degraded": {
          "default": false,
          "title": "Degraded",
          "type": "boolean"
        },
        "degraded_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Degraded Reasons",
          "type": "array"
        },
        "draft_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Draft Input Sha256",
          "type": "string"
        },
        "feature_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Feature Sha256",
          "type": "string"
        },
        "market_assessments": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Market Assessments",
          "type": "object"
        },
        "match_id": {
          "minLength": 1,
          "title": "Match Id",
          "type": "string"
        },
        "retrieval_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Retrieval Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 4,
          "default": 4,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "match_id",
        "as_of",
        "draft_input_sha256",
        "feature_sha256",
        "retrieval_sha256",
        "baseline_sha256",
        "bundle_sha256"
      ],
      "title": "EvaluationBundleV4",
      "type": "object"
    },
    "FormalAnalysisGateV2": {
      "additionalProperties": false,
      "properties": {
        "cutoff_status": {
          "enum": [
            "valid",
            "invalid"
          ],
          "title": "Cutoff Status",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "identity_status": {
          "enum": [
            "valid",
            "conflicted"
          ],
          "title": "Identity Status",
          "type": "string"
        },
        "lifecycle_status": {
          "enum": [
            "ready",
            "pass"
          ],
          "title": "Lifecycle Status",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "lifecycle_status",
        "identity_status",
        "cutoff_status"
      ],
      "title": "FormalAnalysisGateV2",
      "type": "object"
    },
    "MachineRuleEvent": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "enum": [
            "applicable",
            "not_applicable"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "correlation_keys": {
          "items": {
            "type": "string"
          },
          "title": "Correlation Keys",
          "type": "array"
        },
        "counter_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence",
          "type": "array"
        },
        "effect": {
          "enum": [
            "ranking",
            "handicap_signal",
            "total_goals_pool",
            "score_pool",
            "outcome_risk_pool",
            "control"
          ],
          "title": "Effect",
          "type": "string"
        },
        "not_triggered_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Triggered Reason"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "source_provider_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Provider Ids",
          "type": "array"
        },
        "source_snapshot_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        },
        "target_market": {
          "title": "Target Market",
          "type": "string"
        },
        "target_selection": {
          "title": "Target Selection",
          "type": "string"
        },
        "threshold_observations": {
          "additionalProperties": true,
          "title": "Threshold Observations",
          "type": "object"
        },
        "triggered": {
          "title": "Triggered",
          "type": "boolean"
        }
      },
      "required": [
        "rule_id",
        "triggered",
        "applicability",
        "effect",
        "target_market",
        "target_selection"
      ],
      "title": "MachineRuleEvent",
      "type": "object"
    },
    "MarketAssessmentV1": {
      "additionalProperties": false,
      "properties": {
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "degradation_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Degradation Reasons",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "input_mode": {
          "enum": [
            "market_only",
            "full_context"
          ],
          "title": "Input Mode",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "market": {
          "enum": [
            "one_x_two",
            "asian_handicap",
            "fixed_handicap_1x2",
            "total_goals",
            "score"
          ],
          "title": "Market",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        },
        "missing_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Missing Inputs",
          "type": "array"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        },
        "pass_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Pass Reasons",
          "type": "array"
        },
        "provider_ids": {
          "items": {
            "type": "string"
          },
          "title": "Provider Ids",
          "type": "array"
        },
        "ranking": {
          "items": {
            "type": "string"
          },
          "title": "Ranking",
          "type": "array"
        },
        "status": {
          "enum": [
            "assessed",
            "degraded",
            "pass"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "market",
        "status",
        "input_mode"
      ],
      "title": "MarketAssessmentV1",
      "type": "object"
    },
    "TotalGoalsSeriesV2": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "title": "Line",
          "type": "number"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        },
        "odds_format": {
          "title": "Odds Format",
          "type": "string"
        },
        "over_change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Over Change"
        },
        "over_purity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Over Purity"
        },
        "provider_id": {
          "title": "Provider Id",
          "type": "string"
        },
        "qualified_side": {
          "anyOf": [
            {
              "enum": [
                "over",
                "under"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualified Side"
        },
        "under_change": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Under Change"
        },
        "under_purity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Under Purity"
        }
      },
      "required": [
        "provider_id",
        "line",
        "odds_format",
        "observation_ids",
        "over_change",
        "under_change",
        "over_purity",
        "under_purity"
      ],
      "title": "TotalGoalsSeriesV2",
      "type": "object"
    },
    "TotalGoalsSignalV5": {
      "additionalProperties": false,
      "description": "A verified market direction, deliberately not an invented score range.",
      "properties": {
        "line": {
          "exclusiveMinimum": 0,
          "title": "Line",
          "type": "number"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 6,
          "title": "Observation Ids",
          "type": "array"
        },
        "provider_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Provider Ids",
          "type": "array"
        },
        "side": {
          "enum": [
            "over",
            "under"
          ],
          "title": "Side",
          "type": "string"
        }
      },
      "required": [
        "side",
        "provider_ids",
        "observation_ids",
        "line"
      ],
      "title": "TotalGoalsSignalV5",
      "type": "object"
    }
  },
  "$id": "https://odds-journal.local/schemas/rule-evaluation-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/EvaluationBundle"
    },
    {
      "$ref": "#/$defs/EvaluationBundleV2"
    },
    {
      "$ref": "#/$defs/EvaluationBundleV3"
    },
    {
      "$ref": "#/$defs/EvaluationBundleV4"
    }
  ]
}
