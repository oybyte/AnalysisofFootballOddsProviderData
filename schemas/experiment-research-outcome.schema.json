{
  "$defs": {
    "ExperimentResearchOutcomeEvent": {
      "additionalProperties": false,
      "description": "A postmatch record is deliberately not a prediction evaluation.",
      "properties": {
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "status": {
          "const": "recorded",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "status",
        "reason"
      ],
      "title": "ExperimentResearchOutcomeEvent",
      "type": "object"
    }
  },
  "$id": "https://odds-journal.local/schemas/experiment-research-outcome.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Postmatch recording for research_only specs; it cannot contain a prediction.",
  "properties": {
    "events": {
      "items": {
        "$ref": "#/$defs/ExperimentResearchOutcomeEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "experiment_research_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Experiment Research Bundle Sha256",
      "type": "string"
    },
    "final_score": {
      "pattern": "^\\d+-\\d+$",
      "title": "Final Score",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "outcome_id": {
      "title": "Outcome Id",
      "type": "string"
    },
    "outcome_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Outcome Sha256",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "outcome_id",
    "match_id",
    "experiment_research_bundle_sha256",
    "recorded_at",
    "final_score",
    "outcome_sha256"
  ],
  "title": "ExperimentResearchOutcome",
  "type": "object"
}
