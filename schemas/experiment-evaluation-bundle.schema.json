{
  "$defs": {
    "ExperimentRuleEvent": {
      "additionalProperties": false,
      "properties": {
        "deterministic_observations": {
          "additionalProperties": true,
          "title": "Deterministic Observations",
          "type": "object"
        },
        "effect": {
          "enum": [
            "total_goals_pool",
            "outcome_risk_pool",
            "control"
          ],
          "title": "Effect",
          "type": "string"
        },
        "independence_keys": {
          "items": {
            "type": "string"
          },
          "title": "Independence Keys",
          "type": "array"
        },
        "original_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Status"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "requires_ai_confirmation": {
          "title": "Requires Ai Confirmation",
          "type": "boolean"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "signal_direction": {
          "enum": [
            "over",
            "under",
            "neutral"
          ],
          "title": "Signal Direction",
          "type": "string"
        },
        "signal_tier": {
          "enum": [
            "consensus",
            "disputed",
            "anomalous"
          ],
          "title": "Signal Tier",
          "type": "string"
        },
        "source_provider_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Provider Ids",
          "type": "array"
        },
        "source_snapshot_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "status": {
          "enum": [
            "triggered",
            "not_triggered",
            "not_applicable",
            "suppressed",
            "insufficient_data"
          ],
          "title": "Status",
          "type": "string"
        },
        "suppressed_by_rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suppressed By Rule Id"
        },
        "suppressed_external_rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Suppressed External Rule Ids",
          "type": "array"
        },
        "suppression_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suppression Reason"
        },
        "target_selection": {
          "enum": [
            "over",
            "under",
            "pass"
          ],
          "title": "Target Selection",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "status",
        "effect",
        "target_selection",
        "signal_direction",
        "signal_tier",
        "requires_ai_confirmation",
        "reason"
      ],
      "title": "ExperimentRuleEvent",
      "type": "object"
    }
  },
  "$id": "https://odds-journal.local/schemas/experiment-evaluation-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "causal_attribution": {
      "const": "unverified",
      "default": "unverified",
      "title": "Causal Attribution",
      "type": "string"
    },
    "competition_code": {
      "title": "Competition Code",
      "type": "string"
    },
    "cutoff_at": {
      "format": "date-time",
      "title": "Cutoff At",
      "type": "string"
    },
    "draft_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Draft Input Sha256",
      "type": "string"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/ExperimentRuleEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "experiment_receipt_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Experiment Receipt Sha256",
      "type": "string"
    },
    "experiment_ruleset_version": {
      "title": "Experiment Ruleset Version",
      "type": "string"
    },
    "feature_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Snapshot Sha256",
      "type": "string"
    },
    "features": {
      "additionalProperties": true,
      "title": "Features",
      "type": "object"
    },
    "fund_flow_status": {
      "const": "unknown",
      "default": "unknown",
      "title": "Fund Flow Status",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "official_outlook_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Official Outlook Sha256",
      "type": "string"
    },
    "profile_chain": {
      "items": {
        "type": "string"
      },
      "title": "Profile Chain",
      "type": "array"
    },
    "proposal_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Proposal Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "match_id",
    "competition_code",
    "experiment_ruleset_version",
    "proposal_sha256",
    "cutoff_at",
    "experiment_receipt_sha256",
    "official_outlook_sha256",
    "draft_input_sha256",
    "feature_snapshot_sha256",
    "profile_chain",
    "features",
    "events",
    "bundle_sha256"
  ],
  "title": "ExperimentEvaluationBundle",
  "type": "object"
}
