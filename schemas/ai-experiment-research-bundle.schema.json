{
  "$defs": {
    "AIExperimentStageEventV1": {
      "additionalProperties": false,
      "properties": {
        "cost": {
          "minimum": 0,
          "title": "Cost",
          "type": "number"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_response_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Response Id"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "response_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Sha256"
        },
        "retries": {
          "minimum": 0,
          "title": "Retries",
          "type": "integer"
        },
        "stage": {
          "enum": [
            "facts",
            "rules",
            "cases",
            "prediction",
            "risk"
          ],
          "title": "Stage",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "unavailable",
            "failed",
            "no_case_comparison"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "stage",
        "status",
        "input_sha256",
        "input_tokens",
        "output_tokens",
        "cost",
        "retries"
      ],
      "title": "AIExperimentStageEventV1",
      "type": "object"
    }
  },
  "$id": "https://odds-journal.local/schemas/ai-experiment-research-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Sha256",
      "type": "string"
    },
    "feature_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Feature Snapshot Sha256",
      "type": "string"
    },
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "official_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Official Input Sha256",
      "type": "string"
    },
    "receipt_id": {
      "title": "Receipt Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/AIExperimentStageEventV1"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "Stages",
      "type": "array"
    }
  },
  "required": [
    "receipt_id",
    "match_id",
    "official_input_sha256",
    "feature_snapshot_sha256",
    "stages",
    "bundle_sha256"
  ],
  "title": "AIExperimentBundleV1",
  "type": "object"
}
