{
  "$defs": {
    "MediaLocation": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "round_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Round No"
        },
        "source_path": {
          "title": "Source Path",
          "type": "string"
        }
      },
      "required": [
        "source_path"
      ],
      "title": "MediaLocation",
      "type": "object"
    }
  },
  "$id": "https://odds-journal.local/schemas/media-inventory.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "decode_status": {
      "enum": [
        "valid",
        "zero_byte",
        "corrupt"
      ],
      "title": "Decode Status",
      "type": "string"
    },
    "duplicate_of": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duplicate Of"
    },
    "height": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Height"
    },
    "html_locations": {
      "items": {
        "$ref": "#/$defs/MediaLocation"
      },
      "title": "Html Locations",
      "type": "array"
    },
    "mapped_rounds": {
      "items": {
        "type": "integer"
      },
      "title": "Mapped Rounds",
      "type": "array"
    },
    "mapping_status": {
      "enum": [
        "referenced",
        "html_recovered",
        "orphan",
        "unavailable"
      ],
      "title": "Mapping Status",
      "type": "string"
    },
    "media_id": {
      "title": "Media Id",
      "type": "string"
    },
    "mime_type": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Mime Type"
    },
    "reference_locations": {
      "items": {
        "$ref": "#/$defs/MediaLocation"
      },
      "title": "Reference Locations",
      "type": "array"
    },
    "review_status": {
      "enum": [
        "pending",
        "reviewed",
        "excluded",
        "unavailable"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Sha256",
      "type": "string"
    },
    "size": {
      "minimum": 0,
      "title": "Size",
      "type": "integer"
    },
    "source_path": {
      "title": "Source Path",
      "type": "string"
    },
    "width": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Width"
    }
  },
  "required": [
    "media_id",
    "source_path",
    "sha256",
    "size",
    "decode_status",
    "mapping_status",
    "review_status"
  ],
  "title": "MediaInventory",
  "type": "object"
}
