{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/media-inventory.schema.json",
  "title": "Source media inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "media_id", "source_path", "sha256", "size", "decode_status", "reference_locations", "html_locations", "mapped_rounds", "mapping_status", "review_status"],
  "properties": {
    "schema_version": {"const": 1},
    "media_id": {"type": "string"},
    "source_path": {"type": "string"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "size": {"type": "integer", "minimum": 0},
    "mime_type": {"type": ["string", "null"]},
    "width": {"type": ["integer", "null"]},
    "height": {"type": ["integer", "null"]},
    "decode_status": {"enum": ["valid", "zero_byte", "corrupt"]},
    "reference_locations": {"type": "array"},
    "html_locations": {"type": "array"},
    "mapped_rounds": {"type": "array", "items": {"type": "integer"}, "uniqueItems": true},
    "mapping_status": {"enum": ["referenced", "html_recovered", "orphan", "unavailable"]},
    "duplicate_of": {"type": ["string", "null"]},
    "review_status": {"enum": ["pending", "reviewed", "excluded", "unavailable"]}
  }
}
