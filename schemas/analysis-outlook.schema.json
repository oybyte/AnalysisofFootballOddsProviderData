{
  "$defs": {
    "AnalysisDataMode": {
      "enum": [
        "complete",
        "degraded",
        "pass"
      ],
      "title": "AnalysisDataMode",
      "type": "string"
    },
    "AnalysisDimension": {
      "enum": [
        "asian_handicap_market",
        "european_odds",
        "kelly_index",
        "total_goals_market"
      ],
      "title": "AnalysisDimension",
      "type": "string"
    },
    "AsianCalibrationSummary": {
      "additionalProperties": false,
      "properties": {
        "cover_signal": {
          "default": "neutral",
          "enum": [
            "support",
            "risk",
            "neutral"
          ],
          "title": "Cover Signal",
          "type": "string"
        },
        "cover_signal_rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cover Signal Rule Ids",
          "type": "array"
        }
      },
      "title": "AsianCalibrationSummary",
      "type": "object"
    },
    "AsianHandicapOutlook": {
      "properties": {
        "home_line": {
          "title": "Home Line",
          "type": "number"
        },
        "line_display": {
          "minLength": 1,
          "title": "Line Display",
          "type": "string"
        },
        "ranking": {
          "$ref": "#/$defs/RankedOutcomes"
        }
      },
      "required": [
        "line_display",
        "home_line",
        "ranking"
      ],
      "title": "AsianHandicapOutlook",
      "type": "object"
    },
    "CalibrationEvent": {
      "additionalProperties": false,
      "properties": {
        "adjustment_level": {
          "maximum": 1,
          "minimum": -1,
          "title": "Adjustment Level",
          "type": "integer"
        },
        "before_ranking": {
          "items": {
            "type": "string"
          },
          "title": "Before Ranking",
          "type": "array"
        },
        "correlation_keys": {
          "items": {
            "type": "string"
          },
          "title": "Correlation Keys",
          "type": "array"
        },
        "counter_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence",
          "type": "array"
        },
        "final_ranking": {
          "items": {
            "type": "string"
          },
          "title": "Final Ranking",
          "type": "array"
        },
        "not_triggered_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Triggered Reason"
        },
        "primary_changed": {
          "default": false,
          "title": "Primary Changed",
          "type": "boolean"
        },
        "proposed_ranking": {
          "items": {
            "type": "string"
          },
          "title": "Proposed Ranking",
          "type": "array"
        },
        "reliability": {
          "const": "experimental",
          "default": "experimental",
          "title": "Reliability",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "source_dimensions": {
          "items": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Source Dimensions",
          "type": "array"
        },
        "source_provider_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Provider Ids",
          "type": "array"
        },
        "source_snapshot_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        },
        "target_market": {
          "enum": [
            "one_x_two",
            "fixed_handicap_1x2"
          ],
          "title": "Target Market",
          "type": "string"
        },
        "target_selection": {
          "title": "Target Selection",
          "type": "string"
        },
        "threshold_observations": {
          "additionalProperties": true,
          "title": "Threshold Observations",
          "type": "object"
        },
        "triggered": {
          "title": "Triggered",
          "type": "boolean"
        }
      },
      "required": [
        "rule_id",
        "triggered",
        "target_market",
        "target_selection",
        "adjustment_level"
      ],
      "title": "CalibrationEvent",
      "type": "object"
    },
    "CalibrationMarketSummary": {
      "additionalProperties": false,
      "properties": {
        "anchor_change_eligible": {
          "default": false,
          "title": "Anchor Change Eligible",
          "type": "boolean"
        },
        "anchor_change_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Change Reason"
        },
        "anchor_changed": {
          "default": false,
          "title": "Anchor Changed",
          "type": "boolean"
        },
        "baseline_ranking": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Baseline Ranking",
          "type": "array"
        },
        "final_ranking": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Final Ranking",
          "type": "array"
        }
      },
      "required": [
        "baseline_ranking",
        "final_ranking"
      ],
      "title": "CalibrationMarketSummary",
      "type": "object"
    },
    "CalibrationSummary": {
      "additionalProperties": false,
      "properties": {
        "asian_handicap": {
          "$ref": "#/$defs/AsianCalibrationSummary"
        },
        "fixed_handicap_1x2": {
          "$ref": "#/$defs/CalibrationMarketSummary"
        },
        "one_x_two": {
          "$ref": "#/$defs/CalibrationMarketSummary"
        }
      },
      "required": [
        "one_x_two",
        "fixed_handicap_1x2"
      ],
      "title": "CalibrationSummary",
      "type": "object"
    },
    "DimensionAssessment": {
      "properties": {
        "candidate_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Candidate Scores",
          "type": "object"
        },
        "configured_weight": {
          "maximum": 100,
          "minimum": 0,
          "title": "Configured Weight",
          "type": "integer"
        },
        "correlated_with": {
          "items": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Correlated With",
          "type": "array"
        },
        "counter_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence",
          "type": "array"
        },
        "dimension": {
          "$ref": "#/$defs/AnalysisDimension"
        },
        "effective_weight": {
          "maximum": 100,
          "minimum": 0,
          "title": "Effective Weight",
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Fact Refs",
          "type": "array"
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "configured_weight",
        "effective_weight"
      ],
      "title": "DimensionAssessment",
      "type": "object"
    },
    "FixedHandicapOutlook": {
      "properties": {
        "home_line": {
          "title": "Home Line",
          "type": "integer"
        },
        "ranking": {
          "$ref": "#/$defs/RankedOutcomes"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "home_line",
        "source_type",
        "ranking"
      ],
      "title": "FixedHandicapOutlook",
      "type": "object"
    },
    "RankedOutcomes": {
      "properties": {
        "choices": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "choices"
      ],
      "title": "RankedOutcomes",
      "type": "object"
    },
    "ResonanceStatus": {
      "enum": [
        "resonant",
        "divergent",
        "insufficient"
      ],
      "title": "ResonanceStatus",
      "type": "string"
    },
    "TotalGoalsOutlook": {
      "properties": {
        "maximum": {
          "minimum": 0,
          "title": "Maximum",
          "type": "integer"
        },
        "minimum": {
          "minimum": 0,
          "title": "Minimum",
          "type": "integer"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "title": "TotalGoalsOutlook",
      "type": "object"
    },
    "WeightModel": {
      "properties": {
        "model_id": {
          "default": "asian-core-v1",
          "title": "Model Id",
          "type": "string"
        },
        "weights": {
          "additionalProperties": {
            "type": "integer"
          },
          "propertyNames": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Weights",
          "type": "object"
        }
      },
      "title": "WeightModel",
      "type": "object"
    }
  },
  "$id": "https://odds-journal.local/schemas/analysis-outlook.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "asian_handicap": {
      "anyOf": [
        {
          "$ref": "#/$defs/AsianHandicapOutlook"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "calibration_contract_version": {
      "anyOf": [
        {
          "const": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration Contract Version"
    },
    "calibration_events": {
      "items": {
        "$ref": "#/$defs/CalibrationEvent"
      },
      "title": "Calibration Events",
      "type": "array"
    },
    "calibration_summary": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalibrationSummary"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "competition_profile": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Competition Profile"
    },
    "correlated_dimensions": {
      "items": {
        "$ref": "#/$defs/AnalysisDimension"
      },
      "title": "Correlated Dimensions",
      "type": "array"
    },
    "data_mode": {
      "$ref": "#/$defs/AnalysisDataMode"
    },
    "dimension_assessments": {
      "items": {
        "$ref": "#/$defs/DimensionAssessment"
      },
      "title": "Dimension Assessments",
      "type": "array"
    },
    "fixed_handicap_1x2": {
      "anyOf": [
        {
          "$ref": "#/$defs/FixedHandicapOutlook"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "independent_dimensions": {
      "items": {
        "$ref": "#/$defs/AnalysisDimension"
      },
      "title": "Independent Dimensions",
      "type": "array"
    },
    "missing_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Missing Reasons",
      "type": "array"
    },
    "one_x_two": {
      "anyOf": [
        {
          "$ref": "#/$defs/RankedOutcomes"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pass_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Pass Reasons",
      "type": "array"
    },
    "resonance_status": {
      "$ref": "#/$defs/ResonanceStatus",
      "default": "insufficient"
    },
    "schema_version": {
      "default": 1,
      "enum": [
        1,
        2
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "score_candidates": {
      "items": {
        "type": "string"
      },
      "title": "Score Candidates",
      "type": "array"
    },
    "total_goals": {
      "anyOf": [
        {
          "$ref": "#/$defs/TotalGoalsOutlook"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "weight_model": {
      "$ref": "#/$defs/WeightModel"
    }
  },
  "required": [
    "data_mode"
  ],
  "title": "AnalysisOutlook",
  "type": "object"
}
