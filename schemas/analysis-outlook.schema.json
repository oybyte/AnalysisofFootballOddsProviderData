{
  "$defs": {
    "AnalysisDataMode": {
      "enum": [
        "complete",
        "degraded",
        "pass"
      ],
      "title": "AnalysisDataMode",
      "type": "string"
    },
    "AnalysisDimension": {
      "enum": [
        "asian_handicap_market",
        "european_odds",
        "kelly_index",
        "total_goals_market"
      ],
      "title": "AnalysisDimension",
      "type": "string"
    },
    "AnalysisOutlook": {
      "properties": {
        "analysis_input_mode": {
          "anyOf": [
            {
              "enum": [
                "market_only",
                "full_context"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Input Mode"
        },
        "anchor_change_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Change Reason"
        },
        "asian_handicap": {
          "anyOf": [
            {
              "$ref": "#/$defs/AsianHandicapOutlook"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "baseline_gate": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineGate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "baseline_summary_v3": {
          "anyOf": [
            {
              "$ref": "#/$defs/BaselineSummaryV3"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "calibration_contract_version": {
          "anyOf": [
            {
              "enum": [
                1,
                2,
                3,
                4,
                7,
                8
              ],
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Contract Version"
        },
        "calibration_events": {
          "items": {
            "$ref": "#/$defs/CalibrationEvent"
          },
          "title": "Calibration Events",
          "type": "array"
        },
        "calibration_summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/CalibrationSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "competition_profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Competition Profile"
        },
        "correlated_dimensions": {
          "items": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Correlated Dimensions",
          "type": "array"
        },
        "data_mode": {
          "$ref": "#/$defs/AnalysisDataMode"
        },
        "decision_actor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Actor"
        },
        "dimension_assessments": {
          "items": {
            "$ref": "#/$defs/DimensionAssessment"
          },
          "title": "Dimension Assessments",
          "type": "array"
        },
        "evaluation_bundle_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluation Bundle Sha256"
        },
        "experimental_rankings": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Experimental Rankings",
          "type": "object"
        },
        "final_rankings": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Final Rankings",
          "type": "object"
        },
        "fixed_handicap_1x2": {
          "anyOf": [
            {
              "$ref": "#/$defs/FixedHandicapOutlook"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "formal_gate": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formal Gate"
        },
        "independent_dimensions": {
          "items": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Independent Dimensions",
          "type": "array"
        },
        "market_assessments": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Market Assessments",
          "type": "object"
        },
        "market_pass_reasons": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "one_x_two",
              "asian_handicap",
              "fixed_handicap_1x2",
              "total_goals",
              "score"
            ]
          },
          "title": "Market Pass Reasons",
          "type": "object"
        },
        "market_statuses": {
          "additionalProperties": {
            "$ref": "#/$defs/MarketDecisionStatus"
          },
          "propertyNames": {
            "enum": [
              "one_x_two",
              "asian_handicap",
              "fixed_handicap_1x2",
              "total_goals",
              "score"
            ]
          },
          "title": "Market Statuses",
          "type": "object"
        },
        "missing_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Missing Reasons",
          "type": "array"
        },
        "one_x_two": {
          "anyOf": [
            {
              "$ref": "#/$defs/RankedOutcomes"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome_risk_pool": {
          "items": {
            "$ref": "#/$defs/OutcomeRiskCandidate"
          },
          "title": "Outcome Risk Pool",
          "type": "array"
        },
        "pass_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Pass Reasons",
          "type": "array"
        },
        "profile_chain": {
          "items": {
            "type": "string"
          },
          "title": "Profile Chain",
          "type": "array"
        },
        "resonance_status": {
          "$ref": "#/$defs/ResonanceStatus",
          "default": "insufficient"
        },
        "schema_version": {
          "default": 1,
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "score_candidate_pool": {
          "items": {
            "$ref": "#/$defs/ScoreCandidate"
          },
          "title": "Score Candidate Pool",
          "type": "array"
        },
        "score_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Score Candidates",
          "type": "array"
        },
        "score_matrix": {
          "anyOf": [
            {
              "$ref": "#/$defs/MultiMarketScoreMatrix"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "total_goals": {
          "anyOf": [
            {
              "$ref": "#/$defs/TotalGoalsOutlook"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "total_goals_candidate_pool": {
          "items": {
            "$ref": "#/$defs/TotalGoalsCandidate"
          },
          "title": "Total Goals Candidate Pool",
          "type": "array"
        },
        "total_goals_signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/TotalGoalsSignalV5"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "weight_model": {
          "$ref": "#/$defs/WeightModel"
        }
      },
      "required": [
        "data_mode"
      ],
      "title": "AnalysisOutlook",
      "type": "object"
    },
    "AnalysisOutlookV7": {
      "additionalProperties": false,
      "description": "Contract 9 AnalysisOutlook V7。\n\n保留现有正式市场状态 status，新增独立知识状态。",
      "properties": {
        "analysis_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Analysis Receipt Sha256",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "candidates": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Candidates",
          "type": "object"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "degraded": {
          "default": false,
          "title": "Degraded",
          "type": "boolean"
        },
        "draft_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Draft Input Sha256",
          "type": "string"
        },
        "evaluation_bundle_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evaluation Bundle Sha256",
          "type": "string"
        },
        "kickoff_at": {
          "format": "date-time",
          "title": "Kickoff At",
          "type": "string"
        },
        "market_knowledge": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Market Knowledge",
          "type": "object"
        },
        "market_status": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Market Status",
          "type": "object"
        },
        "match_id": {
          "minLength": 1,
          "title": "Match Id",
          "type": "string"
        },
        "outlook_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Outlook Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": 7,
          "default": 7,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "match_id",
        "as_of",
        "kickoff_at",
        "analysis_receipt_sha256",
        "draft_input_sha256",
        "evaluation_bundle_sha256",
        "outlook_sha256"
      ],
      "title": "AnalysisOutlookV7",
      "type": "object"
    },
    "AsianCalibrationSummary": {
      "additionalProperties": false,
      "properties": {
        "cover_signal": {
          "default": "neutral",
          "enum": [
            "support",
            "risk",
            "neutral"
          ],
          "title": "Cover Signal",
          "type": "string"
        },
        "cover_signal_rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Cover Signal Rule Ids",
          "type": "array"
        }
      },
      "title": "AsianCalibrationSummary",
      "type": "object"
    },
    "AsianHandicapOutlook": {
      "properties": {
        "home_line": {
          "title": "Home Line",
          "type": "number"
        },
        "line_display": {
          "minLength": 1,
          "title": "Line Display",
          "type": "string"
        },
        "ranking": {
          "$ref": "#/$defs/RankedOutcomes"
        }
      },
      "required": [
        "line_display",
        "home_line",
        "ranking"
      ],
      "title": "AsianHandicapOutlook",
      "type": "object"
    },
    "BaselineGate": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "ready",
            "degraded",
            "pass"
          ],
          "title": "Decision",
          "type": "string"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Fact Refs",
          "type": "array"
        },
        "facts_status": {
          "enum": [
            "complete",
            "incomplete",
            "conflicted"
          ],
          "title": "Facts Status",
          "type": "string"
        },
        "market_relation": {
          "enum": [
            "aligned",
            "explained_divergence",
            "unexplained_divergence"
          ],
          "title": "Market Relation",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "theoretical_positioning": {
          "enum": [
            "established",
            "unavailable"
          ],
          "title": "Theoretical Positioning",
          "type": "string"
        }
      },
      "required": [
        "facts_status",
        "theoretical_positioning",
        "market_relation",
        "decision"
      ],
      "title": "BaselineGate",
      "type": "object"
    },
    "BaselineSummaryV3": {
      "additionalProperties": false,
      "properties": {
        "markets": {
          "additionalProperties": {
            "$ref": "#/$defs/MarketScoreSummary"
          },
          "title": "Markets",
          "type": "object"
        },
        "pass_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Pass Reasons",
          "type": "array"
        },
        "primary_market": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrimaryMarket"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "primary_selection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Selection"
        }
      },
      "required": [
        "markets"
      ],
      "title": "BaselineSummaryV3",
      "type": "object"
    },
    "CalibrationEvent": {
      "additionalProperties": false,
      "properties": {
        "adjustment_level": {
          "maximum": 1,
          "minimum": -1,
          "title": "Adjustment Level",
          "type": "integer"
        },
        "applicability": {
          "default": "applicable",
          "enum": [
            "applicable",
            "not_applicable"
          ],
          "title": "Applicability",
          "type": "string"
        },
        "before_ranking": {
          "items": {
            "type": "string"
          },
          "title": "Before Ranking",
          "type": "array"
        },
        "contract_version": {
          "default": 2,
          "enum": [
            1,
            2,
            3,
            4,
            7,
            8
          ],
          "title": "Contract Version",
          "type": "integer"
        },
        "correlation_keys": {
          "items": {
            "type": "string"
          },
          "title": "Correlation Keys",
          "type": "array"
        },
        "counter_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence",
          "type": "array"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/CandidateDisposition"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "effect": {
          "default": "ranking",
          "enum": [
            "ranking",
            "handicap_signal",
            "total_goals_pool",
            "score_pool",
            "outcome_risk_pool",
            "control"
          ],
          "title": "Effect",
          "type": "string"
        },
        "final_ranking": {
          "items": {
            "type": "string"
          },
          "title": "Final Ranking",
          "type": "array"
        },
        "not_triggered_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Not Triggered Reason"
        },
        "primary_changed": {
          "default": false,
          "title": "Primary Changed",
          "type": "boolean"
        },
        "proposed_ranking": {
          "items": {
            "type": "string"
          },
          "title": "Proposed Ranking",
          "type": "array"
        },
        "reliability": {
          "const": "experimental",
          "default": "experimental",
          "title": "Reliability",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "source_dimensions": {
          "items": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Source Dimensions",
          "type": "array"
        },
        "source_provider_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Provider Ids",
          "type": "array"
        },
        "source_snapshot_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        },
        "target_market": {
          "anyOf": [
            {
              "enum": [
                "one_x_two",
                "asian_handicap",
                "fixed_handicap_1x2",
                "total_goals",
                "handicap"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Market"
        },
        "target_selection": {
          "title": "Target Selection",
          "type": "string"
        },
        "threshold_observations": {
          "additionalProperties": true,
          "title": "Threshold Observations",
          "type": "object"
        },
        "triggered": {
          "title": "Triggered",
          "type": "boolean"
        }
      },
      "required": [
        "rule_id",
        "triggered",
        "target_selection",
        "adjustment_level"
      ],
      "title": "CalibrationEvent",
      "type": "object"
    },
    "CalibrationMarketSummary": {
      "additionalProperties": false,
      "properties": {
        "anchor_change_eligible": {
          "default": false,
          "title": "Anchor Change Eligible",
          "type": "boolean"
        },
        "anchor_change_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Anchor Change Reason"
        },
        "anchor_changed": {
          "default": false,
          "title": "Anchor Changed",
          "type": "boolean"
        },
        "baseline_ranking": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Baseline Ranking",
          "type": "array"
        },
        "final_ranking": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Final Ranking",
          "type": "array"
        }
      },
      "required": [
        "baseline_ranking",
        "final_ranking"
      ],
      "title": "CalibrationMarketSummary",
      "type": "object"
    },
    "CalibrationSummary": {
      "additionalProperties": false,
      "properties": {
        "asian_handicap": {
          "$ref": "#/$defs/AsianCalibrationSummary"
        },
        "fixed_handicap_1x2": {
          "$ref": "#/$defs/CalibrationMarketSummary"
        },
        "one_x_two": {
          "$ref": "#/$defs/CalibrationMarketSummary"
        }
      },
      "required": [
        "one_x_two",
        "fixed_handicap_1x2"
      ],
      "title": "CalibrationSummary",
      "type": "object"
    },
    "CandidateDisposition": {
      "additionalProperties": false,
      "properties": {
        "counter_evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence Refs",
          "type": "array"
        },
        "disposition": {
          "enum": [
            "adopted",
            "excluded"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "exclusion_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exclusion Reason"
        }
      },
      "required": [
        "disposition"
      ],
      "title": "CandidateDisposition",
      "type": "object"
    },
    "DimensionAssessment": {
      "properties": {
        "candidate_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Candidate Scores",
          "type": "object"
        },
        "configured_weight": {
          "maximum": 100,
          "minimum": 0,
          "title": "Configured Weight",
          "type": "integer"
        },
        "correlated_with": {
          "items": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Correlated With",
          "type": "array"
        },
        "counter_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Counter Evidence",
          "type": "array"
        },
        "dimension": {
          "$ref": "#/$defs/AnalysisDimension"
        },
        "effective_weight": {
          "maximum": 100,
          "minimum": 0,
          "title": "Effective Weight",
          "type": "number"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Fact Refs",
          "type": "array"
        },
        "missing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Evidence",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "configured_weight",
        "effective_weight"
      ],
      "title": "DimensionAssessment",
      "type": "object"
    },
    "FixedHandicapOutlook": {
      "properties": {
        "home_line": {
          "title": "Home Line",
          "type": "integer"
        },
        "ranking": {
          "$ref": "#/$defs/RankedOutcomes"
        },
        "source_type": {
          "minLength": 1,
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "home_line",
        "source_type",
        "ranking"
      ],
      "title": "FixedHandicapOutlook",
      "type": "object"
    },
    "MarketDecisionStatus": {
      "enum": [
        "assessed",
        "degraded",
        "pass"
      ],
      "title": "MarketDecisionStatus",
      "type": "string"
    },
    "MarketScoreCell": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
