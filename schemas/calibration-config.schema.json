{
  "$defs": {
    "CalibrationConfig": {
      "additionalProperties": false,
      "properties": {
        "comparison_policy": {
          "$ref": "#/$defs/ComparisonPolicyConfig"
        },
        "competition_profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/CompetitionProfileConfig"
          },
          "title": "Competition Profiles",
          "type": "object"
        },
        "formal_draft_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/FormalDraftPolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "profile_chains": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Profile Chains",
          "type": "object"
        },
        "profile_id": {
          "enum": [
            "low-stability-v1",
            "football-analysis-v2",
            "football-analysis-v3",
            "football-analysis-v4",
            "football-analysis-v7",
            "football-analysis-v8"
          ],
          "title": "Profile Id",
          "type": "string"
        },
        "recognized_providers": {
          "items": {
            "type": "string"
          },
          "title": "Recognized Providers",
          "type": "array"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/CalibrationRuleConfig"
          },
          "title": "Rules",
          "type": "array"
        },
        "schema_version": {
          "enum": [
            1,
            2,
            3,
            4,
            7,
            8
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "total_goals_evidence_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/TotalGoalsEvidencePolicy"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "profile_id",
        "comparison_policy",
        "competition_profiles",
        "recognized_providers",
        "rules"
      ],
      "title": "CalibrationConfig",
      "type": "object"
    },
    "CalibrationRuleConfig": {
      "additionalProperties": false,
      "properties": {
        "allowed_values": {
          "additionalProperties": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Allowed Values",
          "type": "object"
        },
        "anchor_eligible": {
          "default": false,
          "title": "Anchor Eligible",
          "type": "boolean"
        },
        "effect": {
          "default": "ranking",
          "enum": [
            "ranking",
            "handicap_signal",
            "total_goals_pool",
            "score_pool",
            "outcome_risk_pool",
            "control"
          ],
          "title": "Effect",
          "type": "string"
        },
        "evaluator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluator Id"
        },
        "feature_ids": {
          "items": {
            "type": "string"
          },
          "title": "Feature Ids",
          "type": "array"
        },
        "max_ranking_move": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Ranking Move",
          "type": "integer"
        },
        "reliability": {
          "const": "experimental",
          "default": "experimental",
          "title": "Reliability",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "scope": {
          "default": "global",
          "enum": [
            "global",
            "low_stability",
            "korea"
          ],
          "title": "Scope",
          "type": "string"
        },
        "target_market": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Market"
        },
        "target_selection": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Selection"
        },
        "thresholds": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Thresholds",
          "type": "object"
        }
      },
      "required": [
        "rule_id"
      ],
      "title": "CalibrationRuleConfig",
      "type": "object"
    },
    "ComparisonPolicyConfig": {
      "additionalProperties": false,
      "properties": {
        "asian_water_odds_format": {
          "const": "hong_kong",
          "title": "Asian Water Odds Format",
          "type": "string"
        },
        "european_odds_format": {
          "const": "decimal",
          "title": "European Odds Format",
          "type": "string"
        },
        "kelly_odds_format": {
          "const": "kelly",
          "title": "Kelly Odds Format",
          "type": "string"
        },
        "late_window_minutes": {
          "exclusiveMinimum": 0,
          "title": "Late Window Minutes",
          "type": "integer"
        },
        "required_phases": {
          "items": {
            "enum": [
              "opening",
              "mid",
              "late"
            ],
            "type": "string"
          },
          "title": "Required Phases",
          "type": "array"
        }
      },
      "required": [
        "required_phases",
        "late_window_minutes",
        "asian_water_odds_format",
        "european_odds_format",
        "kelly_odds_format"
      ],
      "title": "ComparisonPolicyConfig",
      "type": "object"
    },
    "CompetitionProfileConfig": {
      "additionalProperties": false,
      "properties": {
        "competition_codes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Competition Codes",
          "type": "array"
        }
      },
      "required": [
        "competition_codes"
      ],
      "title": "CompetitionProfileConfig",
      "type": "object"
    },
    "FormalDraftPolicy": {
      "additionalProperties": false,
      "description": "Contract 8 thresholds for deterministic, market-scoped draft building.",
      "properties": {
        "asian_min_agreeing_providers": {
          "default": 2,
          "minimum": 2,
          "title": "Asian Min Agreeing Providers",
          "type": "integer"
        },
        "asian_min_line_coverage": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0.5,
          "title": "Asian Min Line Coverage",
          "type": "number"
        },
        "asian_min_providers": {
          "default": 2,
          "minimum": 2,
          "title": "Asian Min Providers",
          "type": "integer"
        },
        "directional_probability_gap_min": {
          "default": 0.03,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Directional Probability Gap Min",
          "type": "number"
        },
        "eligible_provider_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Eligible Provider Ids",
          "type": "array"
        },
        "one_x_two_min_agreeing_providers": {
          "default": 2,
          "minimum": 2,
          "title": "One X Two Min Agreeing Providers",
          "type": "integer"
        },
        "one_x_two_min_providers": {
          "default": 3,
          "minimum": 3,
          "title": "One X Two Min Providers",
          "type": "integer"
        }
      },
      "required": [
        "eligible_provider_ids"
      ],
      "title": "FormalDraftPolicy",
      "type": "object"
    },
    "KnowledgeEnginePolicyV1": {
      "additionalProperties": false,
      "description": "Contract 9 知识引擎策略配置。\n\n匹配 calibration/football-analysis-v9.yml 的嵌套结构。\n各嵌套节为策略声明，用 dict 保持灵活性，model_validator 强制关键不变量。",
      "properties": {
        "formal_isolation": {
          "additionalProperties": true,
          "title": "Formal Isolation",
          "type": "object"
        },
        "formal_mode": {
          "enum": [
            "disabled_until_release",
            "enabled"
          ],
          "title": "Formal Mode",
          "type": "string"
        },
        "knowledge_snapshot": {
          "additionalProperties": true,
          "title": "Knowledge Snapshot",
          "type": "object"
        },
        "outbound": {
          "additionalProperties": true,
          "title": "Outbound",
          "type": "object"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "reasoner": {
          "additionalProperties": true,
          "title": "Reasoner",
          "type": "object"
        },
        "retrieval": {
          "additionalProperties": true,
          "title": "Retrieval",
          "type": "object"
        },
        "ruleset_origin": {
          "enum": [
            "proposal",
            "published"
          ],
          "title": "Ruleset Origin",
          "type": "string"
        },
        "schema_version": {
          "const": 9,
          "default": 9,
          "title": "Schema Version",
          "type": "integer"
        },
        "study": {
          "additionalProperties": true,
          "title": "Study",
          "type": "object"
        }
      },
      "required": [
        "profile_id",
        "ruleset_origin",
        "formal_mode"
      ],
      "title": "KnowledgeEnginePolicyV1",
      "type": "object"
    },
    "TotalGoalsEvidencePolicy": {
      "additionalProperties": false,
      "description": "Contract 7 guardrails for a directional total-goals conclusion.",
      "properties": {
        "anchor_min_exact_nodes": {
          "default": 3,
          "minimum": 3,
          "title": "Anchor Min Exact Nodes",
          "type": "integer"
        },
        "corroboration_min_exact_nodes": {
          "default": 3,
          "minimum": 3,
          "title": "Corroboration Min Exact Nodes",
          "type": "integer"
        },
        "target_water_fall_min": {
          "default": 0.05,
          "exclusiveMinimum": 0,
          "title": "Target Water Fall Min",
          "type": "number"
        },
        "trend_purity_min": {
          "default": 0.67,
          "maximum": 1,
          "minimum": 0,
          "title": "Trend Purity Min",
          "type": "number"
        }
      },
      "title": "TotalGoalsEvidencePolicy",
      "type": "object"
    }
  },
  "$id": "https://odds-journal.local/schemas/calibration-config.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/CalibrationConfig"
    },
    {
      "$ref": "#/$defs/KnowledgeEnginePolicyV1"
    }
  ]
}
