{
  "$defs": {
    "AnalysisDimension": {
      "enum": [
        "asian_handicap_market",
        "european_odds",
        "kelly_index",
        "total_goals_market"
      ],
      "title": "AnalysisDimension",
      "type": "string"
    },
    "AnalysisDraftInput": {
      "additionalProperties": false,
      "description": "Human/AI supplied baseline evidence. Contract 4 code only aggregates it.",
      "properties": {
        "analysis_input_mode": {
          "enum": [
            "market_only",
            "full_context"
          ],
          "title": "Analysis Input Mode",
          "type": "string"
        },
        "baseline_gate": {
          "$ref": "#/$defs/BaselineGate"
        },
        "baseline_output": {
          "$ref": "#/$defs/BaselineOutput"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Refs",
          "type": "array"
        },
        "hypothesis_a": {
          "minLength": 1,
          "title": "Hypothesis A",
          "type": "string"
        },
        "hypothesis_b": {
          "minLength": 1,
          "title": "Hypothesis B",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "score_matrix": {
          "$ref": "#/$defs/MultiMarketScoreMatrix"
        }
      },
      "required": [
        "analysis_input_mode",
        "baseline_gate",
        "score_matrix",
        "baseline_output",
        "fact_refs",
        "hypothesis_a",
        "hypothesis_b"
      ],
      "title": "AnalysisDraftInput",
      "type": "object"
    },
    "AnalysisDraftInputV2": {
      "additionalProperties": false,
      "properties": {
        "analysis_input_mode": {
          "enum": [
            "market_only",
            "full_context"
          ],
          "title": "Analysis Input Mode",
          "type": "string"
        },
        "baseline_gate": {
          "$ref": "#/$defs/BaselineGate"
        },
        "baseline_output": {
          "$ref": "#/$defs/BaselineOutputV2"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Refs",
          "type": "array"
        },
        "hypothesis_a": {
          "minLength": 1,
          "title": "Hypothesis A",
          "type": "string"
        },
        "hypothesis_b": {
          "minLength": 1,
          "title": "Hypothesis B",
          "type": "string"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "score_matrix": {
          "$ref": "#/$defs/MultiMarketScoreMatrix"
        },
        "total_goals": {
          "$ref": "#/$defs/TotalGoalsInputV2"
        }
      },
      "required": [
        "analysis_input_mode",
        "baseline_gate",
        "score_matrix",
        "baseline_output",
        "total_goals",
        "fact_refs",
        "hypothesis_a",
        "hypothesis_b"
      ],
      "title": "AnalysisDraftInputV2",
      "type": "object"
    },
    "AnalysisDraftInputV3": {
      "additionalProperties": false,
      "properties": {
        "analysis_input_mode": {
          "enum": [
            "market_only",
            "full_context"
          ],
          "title": "Analysis Input Mode",
          "type": "string"
        },
        "analysis_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Analysis Receipt Sha256",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "calibration_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Calibration Config Sha256",
          "type": "string"
        },
        "candidate_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Candidate Sha256",
          "type": "string"
        },
        "compiler_version": {
          "const": "formal-draft-v1",
          "default": "formal-draft-v1",
          "title": "Compiler Version",
          "type": "string"
        },
        "fact_bundle_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fact Bundle Sha256"
        },
        "formal_gate": {
          "$ref": "#/$defs/FormalAnalysisGateV2"
        },
        "hypotheses": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Hypotheses",
          "type": "object"
        },
        "market_assessments": {
          "additionalProperties": {
            "$ref": "#/$defs/MarketAssessmentV1"
          },
          "title": "Market Assessments",
          "type": "object"
        },
        "market_observations_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Market Observations Sha256",
          "type": "string"
        },
        "match_id": {
          "title": "Match Id",
          "type": "string"
        },
        "schema_version": {
          "const": 3,
          "default": 3,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "match_id",
        "as_of",
        "analysis_input_mode",
        "calibration_config_sha256",
        "analysis_receipt_sha256",
        "market_observations_sha256",
        "formal_gate",
        "market_assessments",
        "hypotheses",
        "candidate_sha256"
      ],
      "title": "AnalysisDraftInputV3",
      "type": "object"
    },
    "BaselineGate": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "ready",
            "degraded",
            "pass"
          ],
          "title": "Decision",
          "type": "string"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Fact Refs",
          "type": "array"
        },
        "facts_status": {
          "enum": [
            "complete",
            "incomplete",
            "conflicted"
          ],
          "title": "Facts Status",
          "type": "string"
        },
        "market_relation": {
          "enum": [
            "aligned",
            "explained_divergence",
            "unexplained_divergence"
          ],
          "title": "Market Relation",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "theoretical_positioning": {
          "enum": [
            "established",
            "unavailable"
          ],
          "title": "Theoretical Positioning",
          "type": "string"
        }
      },
      "required": [
        "facts_status",
        "theoretical_positioning",
        "market_relation",
        "decision"
      ],
      "title": "BaselineGate",
      "type": "object"
    },
    "BaselineOutput": {
      "additionalProperties": false,
      "properties": {
        "asian_home_line": {
          "title": "Asian Home Line",
          "type": "number"
        },
        "asian_line_display": {
          "title": "Asian Line Display",
          "type": "string"
        },
        "fixed_handicap_home_line": {
          "title": "Fixed Handicap Home Line",
          "type": "integer"
        },
        "fixed_handicap_source_type": {
          "title": "Fixed Handicap Source Type",
          "type": "string"
        },
        "score_candidates": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Score Candidates",
          "type": "array"
        },
        "total_goals_maximum": {
          "minimum": 0,
          "title": "Total Goals Maximum",
          "type": "integer"
        },
        "total_goals_minimum": {
          "minimum": 0,
          "title": "Total Goals Minimum",
          "type": "integer"
        }
      },
      "required": [
        "asian_line_display",
        "asian_home_line",
        "total_goals_minimum",
        "total_goals_maximum",
        "score_candidates",
        "fixed_handicap_home_line",
        "fixed_handicap_source_type"
      ],
      "title": "BaselineOutput",
      "type": "object"
    },
    "BaselineOutputV2": {
      "additionalProperties": false,
      "properties": {
        "asian_home_line": {
          "title": "Asian Home Line",
          "type": "number"
        },
        "asian_line_display": {
          "title": "Asian Line Display",
          "type": "string"
        },
        "fixed_handicap_home_line": {
          "title": "Fixed Handicap Home Line",
          "type": "integer"
        },
        "fixed_handicap_source_type": {
          "title": "Fixed Handicap Source Type",
          "type": "string"
        }
      },
      "required": [
        "asian_line_display",
        "asian_home_line",
        "fixed_handicap_home_line",
        "fixed_handicap_source_type"
      ],
      "title": "BaselineOutputV2",
      "type": "object"
    },
    "FormalAnalysisGateV2": {
      "additionalProperties": false,
      "properties": {
        "cutoff_status": {
          "enum": [
            "valid",
            "invalid"
          ],
          "title": "Cutoff Status",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "identity_status": {
          "enum": [
            "valid",
            "conflicted"
          ],
          "title": "Identity Status",
          "type": "string"
        },
        "lifecycle_status": {
          "enum": [
            "ready",
            "pass"
          ],
          "title": "Lifecycle Status",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "lifecycle_status",
        "identity_status",
        "cutoff_status"
      ],
      "title": "FormalAnalysisGateV2",
      "type": "object"
    },
    "MarketAssessmentV1": {
      "additionalProperties": false,
      "properties": {
        "conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Conflicts",
          "type": "array"
        },
        "degradation_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Degradation Reasons",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "input_mode": {
          "enum": [
            "market_only",
            "full_context"
          ],
          "title": "Input Mode",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "market": {
          "enum": [
            "one_x_two",
            "asian_handicap",
            "fixed_handicap_1x2",
            "total_goals",
            "score"
          ],
          "title": "Market",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": true,
          "title": "Metrics",
          "type": "object"
        },
        "missing_inputs": {
          "items": {
            "type": "string"
          },
          "title": "Missing Inputs",
          "type": "array"
        },
        "observation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Observation Ids",
          "type": "array"
        },
        "pass_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Pass Reasons",
          "type": "array"
        },
        "provider_ids": {
          "items": {
            "type": "string"
          },
          "title": "Provider Ids",
          "type": "array"
        },
        "ranking": {
          "items": {
            "type": "string"
          },
          "title": "Ranking",
          "type": "array"
        },
        "status": {
          "enum": [
            "assessed",
            "degraded",
            "pass"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "market",
        "status",
        "input_mode"
      ],
      "title": "MarketAssessmentV1",
      "type": "object"
    },
    "MarketScoreCell": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Scores",
          "type": "object"
        },
        "status": {
          "enum": [
            "assessed",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "MarketScoreCell",
      "type": "object"
    },
    "MultiMarketScoreMatrix": {
      "additionalProperties": false,
      "properties": {
        "rows": {
          "items": {
            "$ref": "#/$defs/ScoreMatrixRow"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "rows"
      ],
      "title": "MultiMarketScoreMatrix",
      "type": "object"
    },
    "ScoreMatrixRow": {
      "additionalProperties": false,
      "properties": {
        "configured_weight": {
          "maximum": 100,
          "minimum": 0,
          "title": "Configured Weight",
          "type": "integer"
        },
        "correlated_with": {
          "items": {
            "$ref": "#/$defs/AnalysisDimension"
          },
          "title": "Correlated With",
          "type": "array"
        },
        "counter_evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Counter Evidence",
          "type": "array"
        },
        "dimension": {
          "$ref": "#/$defs/AnalysisDimension"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "fact_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Fact Refs",
          "type": "array"
        },
        "market_scores": {
          "additionalProperties": {
            "$ref": "#/$defs/MarketScoreCell"
          },
          "title": "Market Scores",
          "type": "object"
        },
        "rule_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Rule Ids",
          "type": "array"
        },
        "source_provider_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Provider Ids",
          "type": "array"
        },
        "source_snapshot_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Snapshot Ids",
          "type": "array"
        },
        "supporting_evidence": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Evidence",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "configured_weight",
        "market_scores",
        "fact_refs",
        "rule_ids",
        "supporting_evidence",
        "counter_evidence",
        "source_provider_ids",
        "source_snapshot_ids"
      ],
      "title": "ScoreMatrixRow",
      "type": "object"
    },
    "TotalGoalsInputV2": {
      "additionalProperties": false,
      "properties": {
        "pass_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Pass Reasons",
          "type": "array"
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "over",
                "under"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "status": {
          "enum": [
            "assessed",
            "pass"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "TotalGoalsInputV2",
      "type": "object"
    }
  },
  "$id": "https://odds-journal.local/schemas/analysis-draft-input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/AnalysisDraftInput"
    },
    {
      "$ref": "#/$defs/AnalysisDraftInputV2"
    },
    {
      "$ref": "#/$defs/AnalysisDraftInputV3"
    }
  ]
}
