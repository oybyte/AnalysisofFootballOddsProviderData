{
  "$id": "https://odds-journal.local/schemas/ai-experiment-research-study.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config_snapshot_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Snapshot Sha256",
      "type": "string"
    },
    "eligible_match_ids": {
      "items": {
        "type": "string"
      },
      "title": "Eligible Match Ids",
      "type": "array"
    },
    "official_baseline_schema_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Official Baseline Schema Sha256",
      "type": "string"
    },
    "registered_at": {
      "format": "date-time",
      "title": "Registered At",
      "type": "string"
    },
    "registered_by": {
      "const": "lcz",
      "title": "Registered By",
      "type": "string"
    },
    "required_capability_profile": {
      "items": {
        "type": "string"
      },
      "title": "Required Capability Profile",
      "type": "array"
    },
    "sample_relation": {
      "const": "out_of_sample",
      "default": "out_of_sample",
      "title": "Sample Relation",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "default": "registered",
      "enum": [
        "registered",
        "closed",
        "superseded"
      ],
      "title": "Status",
      "type": "string"
    },
    "stopping_conditions": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Stopping Conditions",
      "type": "array"
    },
    "study_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Study Id",
      "type": "string"
    },
    "study_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Study Sha256",
      "type": "string"
    }
  },
  "required": [
    "study_id",
    "config_snapshot_sha256",
    "registered_by",
    "registered_at",
    "official_baseline_schema_sha256",
    "stopping_conditions",
    "study_sha256"
  ],
  "title": "AIExperimentStudyV1",
  "type": "object"
}
