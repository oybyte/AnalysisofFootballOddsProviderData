{
  "$id": "https://odds-journal.local/schemas/validation-case.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "baseline_status": {
      "default": "available",
      "enum": [
        "available",
        "baseline_unreconstructable"
      ],
      "title": "Baseline Status",
      "type": "string"
    },
    "case_cluster_id": {
      "title": "Case Cluster Id",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "case_type": {
      "default": "reviewed_match",
      "enum": [
        "reviewed_match",
        "certified_legacy_case"
      ],
      "title": "Case Type",
      "type": "string"
    },
    "certification_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Certification Id"
    },
    "certified_case_revision": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Certified Case Revision"
    },
    "eligibility": {
      "enum": [
        "eligible",
        "ineligible"
      ],
      "title": "Eligibility",
      "type": "string"
    },
    "evidence_ref": {
      "minLength": 1,
      "title": "Evidence Ref",
      "type": "string"
    },
    "ineligibility_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Ineligibility Reasons",
      "type": "array"
    },
    "market_snapshot_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Market Snapshot Sha256"
    },
    "not_triggered_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Not Triggered Reason"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "relation": {
      "enum": [
        "support",
        "counterexample",
        "ambiguous",
        "not_applicable"
      ],
      "title": "Relation",
      "type": "string"
    },
    "rule_evaluation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rule Evaluation"
    },
    "study_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Study Id",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "validation_case_id": {
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Validation Case Id",
      "type": "string"
    }
  },
  "required": [
    "validation_case_id",
    "study_id",
    "case_id",
    "case_cluster_id",
    "evidence_ref",
    "observed_at",
    "relation",
    "eligibility",
    "summary"
  ],
  "title": "ValidationCasePayload",
  "type": "object"
}
