{
  "$id": "https://odds-journal.local/schemas/ruleset.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis_receipt_schema_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Analysis Receipt Schema Version"
    },
    "calibration_config_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration Config Path"
    },
    "calibration_config_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration Config Sha256"
    },
    "calibration_contract_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Calibration Contract Version"
    },
    "conditional_document_ids": {
      "items": {
        "type": "string"
      },
      "title": "Conditional Document Ids",
      "type": "array"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "entry_document_id": {
      "title": "Entry Document Id",
      "type": "string"
    },
    "evidence_snapshot_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence Snapshot Sha256"
    },
    "index_schema_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Index Schema Version"
    },
    "market_data_contract_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Market Data Contract Version"
    },
    "publication_status": {
      "anyOf": [
        {
          "enum": [
            "published",
            "deprecated"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Publication Status"
    },
    "required_document_ids": {
      "items": {
        "type": "string"
      },
      "title": "Required Document Ids",
      "type": "array"
    },
    "retrieval_contract_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieval Contract Version"
    },
    "review_receipt_schema_version": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Receipt Schema Version"
    },
    "ruleset_id": {
      "title": "Ruleset Id",
      "type": "string"
    },
    "ruleset_version": {
      "title": "Ruleset Version",
      "type": "string"
    },
    "schema_version": {
      "enum": [
        1,
        2,
        3,
        4
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "source_coverage_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Coverage Sha256"
    },
    "source_family_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Family Ids",
      "type": "array"
    },
    "status": {
      "anyOf": [
        {
          "enum": [
            "active",
            "superseded",
            "deprecated"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Status"
    },
    "weight_model_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Weight Model Id"
    }
  },
  "required": [
    "schema_version",
    "ruleset_id",
    "ruleset_version",
    "effective_at",
    "entry_document_id",
    "required_document_ids",
    "conditional_document_ids"
  ],
  "title": "RulesetManifest",
  "type": "object"
}
