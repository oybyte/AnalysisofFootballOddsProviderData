{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/ruleset.schema.json",
  "title": "Odds Journal Ruleset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ruleset_id", "ruleset_version", "status", "effective_at", "entry_document_id", "required_document_ids", "conditional_document_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "ruleset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "ruleset_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "status": {"enum": ["active", "superseded", "deprecated"]},
    "effective_at": {"type": "string", "format": "date-time"},
    "entry_document_id": {"type": "string"},
    "required_document_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "conditional_document_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
